{
  "name": "cqa-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "generate:types": "python3 scripts/generate-api-types.py",
    "format": "prettier --write src vite.config.ts",
    "format:check": "prettier --check src vite.config.ts",
    "test": "node --import tsx --test --test-concurrency=2 src/*.test.ts src/*.test.tsx"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "@types/node": "24.10.0",
    "prettier": "3.6.2",
    "jsdom": "26.1.0",
    "@types/jsdom": "21.1.7",
    "tsx": "4.20.6"
  }
}
