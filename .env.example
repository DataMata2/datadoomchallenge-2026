# Backend only. Never put provider credentials in a VITE_* variable.
# scripts/dev.sh derives an absolute database path by default.
CQA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set an ignored backend secret file, or export ANTHROPIC_API_KEY directly.
# CQA_ENV_FILE=/absolute/path/to/ignored/.env
# ANTHROPIC_API_KEY=
CQA_MODEL=claude-sonnet-5-5
# Project-only lock for explicit smoke/bulk preparation.
# Set an absolute model lock path for shared preparation jobs.
# Absolute paths are required by scripts/dev.sh. Defaults resolve to this checkout.
# CQA_DATABASE_PATH=/absolute/path/to/canonical/runtime/cqa.sqlite3
# CQA_MODEL_LOCK=/absolute/path/to/canonical/runtime/model-jobs.lock
# Optional explicit interpreter if backend/.venv is not used.
# CQA_PYTHON=/absolute/path/to/python3.12
# Import helper only; never put signed organizer URLs in version control.
# CQA_DEV_SOURCE_URL=
# Vite server-side proxy target; no browser credential values.
# CQA_API_TARGET=http://127.0.0.1:8000
