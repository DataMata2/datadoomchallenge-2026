    "checklist": {
      "id": "cqa-v1",
      "name": "Conversation quality baseline",
      "parent_version_id": null,
      "instructions": "Evaluate only the human operator in RU, KZ, or EN. Client, bot and system turns remain context. Use one-based evidence indices across the complete original transcript. Give a short rationale and supporting evidence; for an omission identify the checked region where the action was expected; for N/A explain the stated applicability condition. Distinguish solution correctness from dialogue clarity. The three-minute first-response threshold, tags and attachments do not affect scoring. Boolean true earns full weight, false earns zero; numeric scores are proportional to their maximum. Exclude N/A weights and normalize applicable weights to 100; round the total to two decimal places. No applicable weighted criteria means no total. Critical violations are separate and never zero the total.",
      "criteria": [
        {
          "id": "contact",
          "title": "Greeting and introduction",
          "description": "The operator greets the client in the client's language and introduces themselves in the first response.",
          "answer_type": "boolean",
          "allowed_values": [
            false,
            true
          ],
          "scale_meanings": {
            "false": "One or both required actions are absent or incorrect.",
            "true": "Greeting and introduction are both present in the first response."
          },
          "weight": 10,
          "allow_na": false,
          "na_condition": null,
          "critical": false
        },
        {
          "id": "discovery",
          "title": "Understand and clarify the request",
          "description": "The operator uses known details and clarifies missing information before answering.",
          "answer_type": "boolean",
          "allowed_values": [
            false,
            true
          ],
          "scale_meanings": {
            "false": "Needed clarification is omitted or incorrect.",
            "true": "Known details are considered and missing information is clarified before the answer."
          },
          "weight": 15,
          "allow_na": true,
          "na_condition": "The information needed to answer was available from the beginning.",
          "critical": false
        },
        {
          "id": "identification",
          "title": "Verify identity",
          "description": "Identity verification is confirmed before protected disclosure or a protected action. If required verification is not confirmed in the transcript, answer false.",
          "answer_type": "boolean",
          "allowed_values": [
            false,
            true
          ],
          "scale_meanings": {
            "false": "Required verification is absent, unconfirmed or performed after disclosure/action.",
            "true": "Verification is confirmed before protected disclosure/action."
          },
          "weight": 20,
          "allow_na": true,
          "na_condition": "The request does not require identity verification, such as a general question about tariffs.",
          "critical": false
        },
        {
          "id": "consultation",
          "title": "Correctness and completeness",
          "description": "Assess how correctly and completely the request is resolved or the next step is provided.",
          "answer_type": "scale",
          "allowed_values": [
            0,
            5,
            10,
            15,
            20
          ],
          "scale_meanings": {
            "0": "No substantive answer, or the key recommendation is incorrect.",
            "10": "Part of the request is resolved; a substantial question remains open.",
            "15": "The main question is resolved; a secondary detail is omitted.",
            "20": "All substantial questions are resolved, or a correct next step is provided.",
            "5": "General guidance is given, but the client still cannot tell how to proceed."
          },
          "weight": 20,
          "allow_na": true,
          "na_condition": "The conversation ended before the client formulated the request.",
          "critical": false
        },
        {
          "id": "empathy",
          "title": "Courtesy and response to inconvenience",
          "description": "The operator is polite and, when the client expresses dissatisfaction or an inconvenience, responds to that specific problem.",
          "answer_type": "boolean",
          "allowed_values": [
            false,
            true
          ],
          "scale_meanings": {
            "false": "The operator is impolite or fails to address an expressed specific inconvenience.",
            "true": "The operator is polite and responds to the client's specific problem when one is expressed."
          },
          "weight": 15,
          "allow_na": false,
          "na_condition": null,
          "critical": false
        },
        {
          "id": "dialogue",
          "title": "Clarity, sequence and waiting",
          "description": "Assess clarity, sequence, coherence and advance notice of an explicit wait, independently of solution completeness.",
          "answer_type": "scale",
          "allowed_values": [
            0,
            4,
            7,
            10
          ],
          "scale_meanings": {
            "0": "Incoherent or contradictory replies make the dialogue impossible to follow.",
            "10": "Answers are clear and coherent; the operator warns the client when there is an explicit wait.",
            "4": "Wording or answer order forces the client to ask again.",
            "7": "One noticeable disruption, but the client can understand the answer and continue."
          },
          "weight": 15,
          "allow_na": false,
          "na_condition": null,
          "critical": false
        },
        {
          "id": "closure",
          "title": "Summary, further help and farewell",
          "description": "The operator summarizes or offers further help, and says goodbye.",
          "answer_type": "boolean",
          "allowed_values": [
            false,
            true
          ],
          "scale_meanings": {
            "false": "The required closing actions are missing despite an opportunity to close.",
            "true": "A summary or further-help offer is given together with a farewell."
          },
          "weight": 5,
          "allow_na": true,
          "na_condition": "The conversation was interrupted before an opportunity to close.",
          "critical": false
        },
        {
          "id": "critical",
          "title": "Serious violation",
          "description": "Flag an insult, an offer of paid services outside the company, or confidential disclosure. An offer to invest money transferred personally to the operator, or to provide private paid consultation using the client's personal number, is sufficient; client agreement or payment is unnecessary.",
          "answer_type": "boolean",
          "allowed_values": [
            false,
            true
          ],
          "scale_meanings": {
            "false": "None of the three serious violations is detected.",
            "true": "At least one of the three serious violations is detected."
          },
          "weight": 0,
          "allow_na": false,
          "na_condition": null,
          "critical": true
        }
      ]
    },
